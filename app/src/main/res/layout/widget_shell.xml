            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l19"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l20"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l21"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l22"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l23"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextClock
                android:id="@+id/clock_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/flex_bloom_hours"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:textColor="@color/wr_accent" />

            <TextClock
                android:id="@+id/clock_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/flex_bloom_minutes"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:textColor="@color/wr_text" />
        </LinearLayout>

        <TextClock
            android:id="@+id/clock_meridiem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:fontFamily="@font/flex_bloom_meridiem"
            android:format12Hour="a"
            android:format24Hour=""
            android:includeFontPadding="false"
            android:letterSpacing="0.15"
            android:textAllCaps="true"
            android:textColor="@color/wr_text"
            android:visibility="gone" />

        <!-- A media widget's track position, counted by the launcher (Frame.elapsed). -->
        <Chronometer
            android:id="@+id/media_pos"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/wr_text"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/h0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:background="@drawable/widget_hit"
            android:clipToOutline="true"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/h1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:background="@drawable/widget_hit"
            android:clipToOutline="true"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/h2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:background="@drawable/widget_hit"
            android:clipToOutline="true"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/h3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:background="@drawable/widget_hit"
            android:clipToOutline="true"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/h4"
            android:layout_width="0dp"
