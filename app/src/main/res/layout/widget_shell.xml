<?xml version="1.0" encoding="utf-8"?>
<!-- The shell widgets' one layout (ShellWidget): a box sized to the shell widget's aspect
     ratio, its card, alpha-mask layers tinted by colour role, an untinted art layer, the
     Bloom clock's TextClocks and tap zones. Positions and sizes are set from code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/box"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_solid"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/l10"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|start"
