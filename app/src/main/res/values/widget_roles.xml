<?xml version="1.0" encoding="utf-8"?>
<!-- The shell widgets' colour roles (the shell's WidgetColorScheme, default scheme) as the
     system's Material You palette. Android 12-13 has only tonal steps, so these are the
     nearest tones; values-v34 uses the real roles. Layers are tinted with these at
     inflation, so wallpaper and dark mode changes need no redraw. -->
<resources>
    <color name="wr_card">@android:color/system_neutral1_50</color>
    <color name="wr_text">@android:color/system_neutral2_700</color>
    <color name="wr_accent">@android:color/system_accent1_600</color>
    <color name="wr_on_accent">@android:color/system_accent1_0</color>
    <color name="wr_inner">@android:color/system_neutral1_100</color>
    <color name="wr_tonal">@android:color/system_accent2_100</color>
    <color name="wr_on_tonal">@android:color/system_accent2_900</color>
    <color name="wr_surface_variant">@android:color/system_neutral2_100</color>
    <color name="wr_error">#FFB3261E</color>
</resources>
