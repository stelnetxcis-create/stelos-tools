<?xml version="1.0" encoding="utf-8"?>
<!-- Only the events that say "something was copied"; no window content is read. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked|typeNotificationStateChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/clip_service_description"
    android:notificationTimeout="100"
    android:summary="@string/clip_service_summary" />
